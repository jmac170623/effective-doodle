# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (Project Settings → API) — server-only, used by the Stripe
# webhook to write billing status. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Stripe (Developers → API keys / Products / Webhooks)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PRICE_ID=price_your-site-retainer-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# One-time price for an extra Higgsfield animation credit, bought once a
# site's 3 free animations are used up (a separate one-off Stripe Price,
# not the recurring retainer above).
STRIPE_ANIMATION_PRICE_ID=price_your-animation-credit-price-id

# One-time price for an extra AI-powered feedback edit, bought once a
# site's 5 free edits are used up.
STRIPE_EDIT_PRICE_ID=price_your-edit-credit-price-id

# Higgsfield (open.higgsfield.ai → API Keys). Format is "KEY_ID:KEY_SECRET"
# (both halves, colon-separated — copy exactly as shown when the key is
# created, it's only shown once). Powers the "Animate this photo" gallery
# feature (lib/higgsfieldAnimator.ts#animatePhoto) for real. The hero
# multi-stage transformation (animateHeroTransformation) is still a
# placeholder pending one more unconfirmed detail — see that file's comments.
HF_CREDENTIALS=your-api-key-id:your-api-key-secret

# Anthropic (console.anthropic.com → API Keys) — optional. Used to write
# unique, tone-matched site copy per business, and to proofread onboarding
# answers. If unset, site generation falls back to the built-in template
# copy and answers are used as typed — nothing breaks.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Vercel (vercel.com/account/tokens → Create Token). Needs a full-account
# token, not a project-scoped one — domain purchases require elevated
# scope beyond project management. Powers real domain connect/purchase
# (lib/vercelDomains.ts). REAL MONEY: every domain purchase charges
# whatever card is on file for the Vercel account this token belongs to —
# see README's "Custom domains" section before enabling this in production.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=prj_your-project-id
# Only needed if your Vercel account is under a team scope (most are, even
# free "Hobby" accounts) — find it in Project Settings → General.
VERCEL_TEAM_ID=team_your-team-id

# Markup percentage applied on top of Vercel's registrar cost when a
# customer buys a domain (lib/stripe.ts#computeDomainRetailPriceUsd).
# Charged in USD regardless of the site retainer's currency, since
# Vercel's registrar always quotes in USD. Defaults to 30 if unset.
DOMAIN_MARKUP_PERCENT=30
